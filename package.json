{
  "name": "@sensinum/strapi-table-field",
  "version": "1.0.3",
  "description": "Table Custom Field for Strapi",
  "keywords": [
    "strapi",
    "table",
    "field",
    "custom field",
    "plugin"
  ],
  "license": "MIT",
  "author": "Sensinum <hello@sensinum.com>",
  "contributors": [
    "Mateusz Ziarko <mziarko@virtuslab.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sensinum/strapi-plugin-table-field.git"
  },
  "bugs": {
    "url": "https://github.com/Sensinum/strapi-plugin-table-field/issues"
  },
  "homepage": "https://github.com/Sensinum/strapi-plugin-table-field#readme",
  "type": "commonjs",
  "strapi": {
    "kind": "plugin",
    "name": "table-field",
    "displayName": "Table Field",
    "description": "Strapi Custom Field with Table data structures handling."
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "yarn test:run"
    }
  },
  "scripts": {
    "prepare": "husky install",
    "build": "yarn clean && strapi-plugin build --minify",
    "clean": "rm -rf dist",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react-intl": "^7.1.6"
  },
  "devDependencies": {
    "@sensinum/strapi-utils": "^1.0.10",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.12.0",
    "@strapi/typescript-utils": "^5.12.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "7.0.4",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "styled-components": "6.1.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "resolutions": {
    "postcss": "^8.5.23",
    "qs": "^6.16.1",
    "nodemailer": "^10.1.4",
    "esbuild": "^0.25.0",
    "stream-json": "^3.6.0",
    "@hono/node-server": "^2.1.3",
    "minimatch": "^11.0.1",
    "webpack-dev-middleware": "^7.4.6",
    "zod": "^4.6.6",
    "vite": "6.4.5",
    "@strapi/pack-up/vite": "6.4.5",
    "@strapi/core/glob": "14.0.2",
    "**/rimraf/glob": "14.0.2",
    "@strapi/strapi/**/glob": "14.0.2"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
